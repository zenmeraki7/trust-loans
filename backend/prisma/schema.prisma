generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  phone         String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  reviews       Review[]
  evidenceFiles EvidenceFile[]
  corrections   CorrectionRequest[]
  notifications Notification[]
  notificationSettings NotificationSettings?
  complaintDrafts ComplaintDraft[]
}

enum UserRole {
  USER
  MODERATOR
  SENIOR_MODERATOR
  DATA_VERIFIER
  ADMIN
  SUPER_ADMIN
  COMPANY_REPRESENTATIVE
  NBFC_REPRESENTATIVE
  ANALYST
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REVOKED
}

model LoanApp {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  logoUrl            String?
  packageName        String?
  developerName      String?
  companyName        String?
  websiteUrl         String?
  playStoreUrl       String?
  appStoreUrl        String?
  claimedNbfcPartner String?
  status             ProfileStatus      @default(UNDER_REVIEW)
  verificationStatus VerificationStatus @default(UNDER_VERIFICATION)
  claimStatus        ClaimStatus        @default(UNCLAIMED)
  trustScore         Int                @default(0)
  riskLevel          RiskLevel          @default(INSUFFICIENT_DATA)
  averageRating      Float              @default(0)
  reviewCount        Int                @default(0)
  grievanceEmail     String?
  supportEmail       String?
  supportPhone       String?
  registeredAddress  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  reviews            Review[]
  complaintSummaries ComplaintSummary[]
  evidenceFiles      EvidenceFile[]
  complaintDrafts    ComplaintDraft[]

  @@index([status])
  @@index([riskLevel])
  @@index([verificationStatus])
}

model ComplaintTemplate {
  id          String                    @id @default(cuid())
  key         String                    @unique
  title       String
  category    ComplaintTemplateCategory
  description String
  outputTypes String[]
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  drafts      ComplaintDraft[]
}

model ComplaintDraft {
  id               String               @id @default(cuid())
  userId           String
  templateId       String?
  loanAppId        String?
  title            String
  templateKey      String
  outputType       ComplaintOutputType
  status           ComplaintDraftStatus @default(DRAFT)
  formData         Json
  generatedSubject String?
  generatedBody    String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user             User                 @relation(fields: [userId], references: [id])
  template         ComplaintTemplate?   @relation(fields: [templateId], references: [id])
  loanApp          LoanApp?             @relation(fields: [loanAppId], references: [id])

  @@index([userId])
  @@index([templateId])
  @@index([loanAppId])
  @@index([status])
}

enum ComplaintTemplateCategory {
  HARASSMENT
  PHOTO_MORPHING
  DATA_MISUSE
  FAKE_LEGAL_NOTICE
  HIDDEN_CHARGES
  PAYMENT_NOT_UPDATED
  LOAN_NOT_CLOSED
  GRIEVANCE_ESCALATION
  RBI_CMS
  CYBERCRIME
  CONSUMER_HELPLINE
  ADVOCATE_BRIEFING
}

enum ComplaintOutputType {
  GRIEVANCE_EMAIL
  RBI_CMS_TEXT
  CYBERCRIME_TEXT
  CONSUMER_HELPLINE_TEXT
  ADVOCATE_BRIEFING_NOTE
  PERSONAL_RECORD
}

enum ComplaintDraftStatus {
  DRAFT
  COMPLETED
  ARCHIVED
  DELETED
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
  UNDER_REVIEW
  HIDDEN
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  PARTIALLY_VERIFIED
  VERIFIED
  UNDER_VERIFICATION
  CONFLICTING_INFORMATION
  NEEDS_MANUAL_REVIEW
}

enum ClaimStatus {
  UNCLAIMED
  CLAIM_PENDING
  CLAIMED
  DISPUTED_CLAIM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  SEVERE_COMPLAINT_PATTERN
  UNDER_REVIEW
  INSUFFICIENT_DATA
}

model Review {
  id                String       @id @default(cuid())
  loanAppId         String
  userId            String?
  title             String
  body              String
  publicBody        String?
  rating            Int
  reviewType        ReviewType
  status            ReviewStatus @default(SUBMITTED)
  displayMode       DisplayMode  @default(ANONYMOUS)
  incidentDate      DateTime?
  loanAmountRange   String?
  tags              String[]
  evidenceSubmitted Boolean      @default(false)
  redactionsApplied Boolean      @default(false)
  helpfulCount      Int          @default(0)
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  loanApp          LoanApp           @relation(fields: [loanAppId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  evidenceFiles    EvidenceFile[]
  companyResponses CompanyResponse[]

  @@index([loanAppId])
  @@index([userId])
  @@index([status])
}

enum ReviewType {
  GENERAL_REVIEW
  HARASSMENT_COMPLAINT
  HIDDEN_CHARGES
  DATA_PRIVACY
  PHOTO_MORPHING_THREAT
  FAKE_LEGAL_NOTICE
  PAYMENT_ISSUE
  LOAN_CLOSURE_ISSUE
  POSITIVE_EXPERIENCE
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  UNDER_MODERATION
  NEEDS_MORE_INFO
  PUBLISHED
  PARTIALLY_PUBLISHED
  REJECTED
  REMOVED_BY_USER
  ESCALATED
}

enum DisplayMode {
  ANONYMOUS
  FIRST_NAME_ONLY
  VERIFIED_BADGE_ONLY
}

model EvidenceFile {
  id               String          @id @default(cuid())
  userId           String?
  loanAppId        String?
  reviewId         String?
  storageKey       String
  maskedFileName   String
  originalFileNameHash String?
  mimeType         String
  fileSizeBytes    Int
  status           EvidenceStatus  @default(UPLOADED)
  privateByDefault Boolean         @default(true)
  sensitiveFlags   String[]
  redactionStatus  RedactionStatus @default(NOT_STARTED)
  uploadedAt       DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  loanApp LoanApp? @relation(fields: [loanAppId], references: [id])
  review  Review?  @relation(fields: [reviewId], references: [id])

  @@index([userId])
  @@index([loanAppId])
  @@index([reviewId])
  @@index([status])
}

enum EvidenceStatus {
  UPLOADED
  SCAN_PENDING
  SENSITIVE_DATA_DETECTED
  PENDING_REVIEW
  REDACTION_REQUIRED
  ACCEPTED_FOR_VERIFICATION
  PRIVATE_ONLY
  REJECTED_FOR_SAFETY
  DELETED
  SCHEDULED_FOR_DELETION
  ESCALATED
}

enum RedactionStatus {
  NOT_STARTED
  IN_PROGRESS
  REDACTED
  APPROVED
  REJECTED
}

model CompanyResponse {
  id              String                  @id @default(cuid())
  reviewId        String
  responderUserId String?
  companyName     String
  body            String
  category        CompanyResponseCategory
  status          ModerationStatus        @default(PENDING)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  review Review @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
  @@index([status])
}

enum CompanyResponseCategory {
  CLARIFICATION
  APOLOGY
  SUPPORT_OFFERED
  DISPUTE
  GENERAL_STATEMENT
}

enum ModerationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  ESCALATED
}

model ComplaintSummary {
  id               String   @id @default(cuid())
  loanAppId        String
  tag              String
  count            Int      @default(0)
  percentage       Float    @default(0)
  lastCalculatedAt DateTime @default(now())

  loanApp LoanApp @relation(fields: [loanAppId], references: [id])

  @@unique([loanAppId, tag])
  @@index([tag])
}

model CorrectionRequest {
  id             String           @id @default(cuid())
  requesterId    String?
  requestType    String
  status         CorrectionStatus @default(SUBMITTED)
  publicItemType String?
  publicItemId   String?
  explanation    String
  currentValue   String?
  proposedValue  String?
  sourceUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  requester User? @relation(fields: [requesterId], references: [id])

  @@index([requesterId])
  @@index([status])
  @@index([publicItemType, publicItemId])
}

enum CorrectionStatus {
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_NEEDED
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  ESCALATED
  CLOSED
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  priority   NotificationPriority @default(NORMAL)
  read       Boolean              @default(false)
  relatedUrl String?
  createdAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([priority])
}

model NotificationSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  emailEnabled         Boolean  @default(true)
  inAppEnabled         Boolean  @default(true)
  reviewStatusUpdates  Boolean  @default(true)
  companyResponseAlerts Boolean @default(true)
  correctionUpdates    Boolean  @default(true)
  evidenceUpdates      Boolean  @default(true)
  adminAlerts          Boolean  @default(false)
  savedAppAlerts       Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  beforeJson Json?
  afterJson  Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ScoringConfig {
  id                              String   @id @default(cuid())
  name                            String   @unique
  active                          Boolean  @default(false)
  averageRatingWeight             Float    @default(20)
  reviewVolumeWeight              Float    @default(10)
  recentComplaintTrendWeight      Float    @default(15)
  complaintSeverityWeight         Float    @default(20)
  verifiedBorrowerWeight          Float    @default(5)
  companyResponseWeight           Float    @default(10)
  grievanceAvailabilityWeight     Float    @default(10)
  publicDetailVerificationWeight  Float    @default(5)
  reviewIntegrityWeight           Float    @default(5)
  severeComplaintPenalty          Float    @default(25)
  privacyComplaintPenalty         Float    @default(15)
  hiddenChargeComplaintPenalty    Float    @default(10)
  staleVerificationPenalty        Float    @default(8)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}
