generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(uuid())
  email                     String
  name                      String?
  phone                     String?
  role                      UserRole                   @default(USER)
  status                    UserStatus                 @default(PENDING_VERIFICATION)
  emailVerified             Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  passwordHash              String?
  passwordSalt              String?
  passwordUpdatedAt         DateTime?
  normalizedEmail           String                     @unique
  emailVerifiedAt           DateTime?
  sessionVersion            Int                        @default(1)
  failedLoginCount          Int                        @default(0)
  lockedUntil               DateTime?
  passwordChangedAt         DateTime?
  auditLogs                 AuditLog[]                 @relation("AuditLogActor")
  createdBusinesses         BusinessAccount[]          @relation("BusinessAccountCreatedBy")
  grantedMemberships        BusinessMembership[]       @relation("BusinessMembershipGrantedBy")
  memberships               BusinessMembership[]       @relation("BusinessMembershipUser")
  submittedRegistrations    BusinessRegistration[]     @relation("BusinessRegistrationSubmittedBy")
  complaintDrafts           ComplaintDraft[]
  corrections               CorrectionRequest[]
  domainVerifications       DomainVerification[]       @relation("DomainVerificationRequestedBy")
  sentEmailVerifications    EmailVerification[]        @relation("EmailVerificationUser")
  verificationTokens        EmailVerificationToken[]
  evidenceFiles             EvidenceFile[]
  harassmentCases           HarassmentCase[]
  informationRequests       InformationRequest[]       @relation("InformationRequestRequestedBy")
  informationResponses      InformationRequest[]       @relation("InformationRequestRespondedBy")
  notifications             Notification[]
  notificationSettings      NotificationSettings?
  officialResponses         OfficialBusinessResponse[] @relation("OfficialBusinessResponseSubmittedBy")
  resetTokens               PasswordResetToken[]
  submittedClaims           ProfileClaim[]             @relation("ProfileClaimSubmittedBy")
  profileCorrections        ProfileCorrectionRequest[] @relation("ProfileCorrectionSubmittedBy")
  createdRegulatoryActions  RegulatoryAction[]         @relation("RegulatoryActionCreatedBy")
  verifiedRegulatoryActions RegulatoryAction[]         @relation("RegulatoryActionVerifiedBy")
  reviews                   Review[]
  reviewReports             ReviewReport[]
  sessions                  Session[]
  verificationDecisions     VerificationDecision[]     @relation("VerificationDecisionReviewer")
  uploadedDocuments         VerificationDocument[]     @relation("VerificationDocumentSubmittedBy")
  verificationReviews       VerificationReview[]       @relation("VerificationReviewAssignedTo")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  sessionVersion    Int
  expiresAt         DateTime
  lastSeenAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  ipHash            String?
  userAgent         String?
  reauthenticatedAt DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoanApp {
  id                        String                 @id @default(cuid())
  slug                      String                 @unique
  name                      String
  logoUrl                   String?
  packageName               String?
  developerName             String?
  companyName               String?
  websiteUrl                String?
  playStoreUrl              String?
  appStoreUrl               String?
  claimedNbfcPartner        String?
  status                    ProfileStatus          @default(UNDER_REVIEW)
  verificationStatus        VerificationStatus     @default(UNDER_VERIFICATION)
  claimStatus               ClaimStatus            @default(UNCLAIMED)
  trustScore                Int                    @default(0)
  riskLevel                 RiskLevel              @default(INSUFFICIENT_DATA)
  averageRating             Float                  @default(0)
  reviewCount               Int                    @default(0)
  grievanceEmail            String?
  supportEmail              String?
  supportPhone              String?
  registeredAddress         String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  legalEntityName           String?
  businessType              String?
  associatedRegulatedEntity String?
  rbiRegistrationNumber     String?
  rbiRegistrationVerifiedAt DateTime?
  rbiRegistrationSourceUrl  String?
  interestRateRange         String?
  processingFees            String?
  latePaymentCharges        String?
  loanTenure                String?
  privacyDisclosure         String?
  contactAccessDisclosure   String?
  recoveryPracticeInfo      String?
  knownComplaintCategories  String[]               @default([])
  publicWarningLabels       String[]               @default([])
  dataSource                String?
  lastReviewedAt            DateTime?
  businessProfiles          BusinessProfile[]
  businessRelationships     BusinessRelationship[]
  complaintDrafts           ComplaintDraft[]
  complaintSummaries        ComplaintSummary[]
  evidenceFiles             EvidenceFile[]
  harassmentCases           HarassmentCase[]
  regulatoryActions         RegulatoryAction[]
  reviews                   Review[]

  @@index([status])
  @@index([riskLevel])
  @@index([verificationStatus])
}

model NbfcCompany {
  id                        String                 @id @default(cuid())
  slug                      String                 @unique
  name                      String
  logoUrl                   String?
  officialWebsite           String?
  supportEmail              String?
  grievanceEmail            String?
  supportPhone              String?
  registeredAddress         String?
  nbfcRegistrationClaim     String?
  companyDescription        String?
  status                    ProfileStatus          @default(PUBLISHED)
  verificationStatus        VerificationStatus     @default(UNDER_VERIFICATION)
  claimStatus               ClaimStatus            @default(UNCLAIMED)
  riskLevel                 RiskLevel              @default(INSUFFICIENT_DATA)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  businessType              String?
  playStoreUrl              String?
  appStoreUrl               String?
  grievanceOfficerName      String?
  rbiRegistrationNumber     String?
  rbiRegistrationVerifiedAt DateTime?
  rbiRegistrationSourceUrl  String?
  associatedRegulatedEntity String?
  interestRateRange         String?
  processingFees            String?
  latePaymentCharges        String?
  loanTenure                String?
  privacyDisclosure         String?
  contactAccessDisclosure   String?
  recoveryPracticeInfo      String?
  knownComplaintCategories  String[]               @default([])
  publicWarningLabels       String[]               @default([])
  dataSource                String?
  lastReviewedAt            DateTime?
  businessProfiles          BusinessProfile[]
  businessRelationships     BusinessRelationship[]
  regulatoryActions         RegulatoryAction[]

  @@index([status])
  @@index([verificationStatus])
  @@index([riskLevel])
}

model BusinessAccount {
  id                    String                     @id @default(cuid())
  legalName             String
  displayName           String?
  slug                  String                     @unique
  accountType           BusinessAccountType
  status                BusinessAccountStatus      @default(PENDING_VERIFICATION)
  version               Int                        @default(1)
  createdByUserId       String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  auditLogs             AuditLog[]
  createdBy             User                       @relation("BusinessAccountCreatedBy", fields: [createdByUserId], references: [id])
  memberships           BusinessMembership[]
  profiles              BusinessProfile[]
  registrations         BusinessRegistration[]
  relationships         BusinessRelationship[]
  documentRequirements  DocumentRequirement[]
  domainVerifications   DomainVerification[]
  emailVerifications    EmailVerification[]
  informationRequests   InformationRequest[]
  notifications         Notification[]
  officialResponses     OfficialBusinessResponse[]
  claims                ProfileClaim[]
  profileCorrections    ProfileCorrectionRequest[]
  regulatoryActions     RegulatoryAction[]
  verificationDecisions VerificationDecision[]
  documents             VerificationDocument[]
  verificationReviews   VerificationReview[]

  @@index([status])
  @@index([createdByUserId])
  @@index([accountType])
}

model BusinessProfile {
  id                        String                     @id @default(cuid())
  businessId                String
  loanAppId                 String?
  nbfcCompanyId             String?
  profileType               BusinessProfileType
  displayName               String
  officialWebsite           String?
  supportEmail              String?
  grievanceEmail            String?
  supportPhone              String?
  registeredAddress         String?
  status                    BusinessProfileStatus      @default(DRAFT)
  version                   Int                        @default(1)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  playStoreUrl              String?
  appStoreUrl               String?
  grievanceOfficerName      String?
  associatedRegulatedEntity String?
  rbiRegistrationNumber     String?
  rbiRegistrationVerifiedAt DateTime?
  rbiRegistrationSourceUrl  String?
  interestRateRange         String?
  processingFees            String?
  latePaymentCharges        String?
  loanTenure                String?
  privacyDisclosure         String?
  contactAccessDisclosure   String?
  recoveryPracticeInfo      String?
  knownComplaintCategories  String[]                   @default([])
  publicWarningLabels       String[]                   @default([])
  dataSource                String?
  lastReviewedAt            DateTime?
  auditLogs                 AuditLog[]
  business                  BusinessAccount            @relation(fields: [businessId], references: [id])
  loanApp                   LoanApp?                   @relation(fields: [loanAppId], references: [id])
  nbfcCompany               NbfcCompany?               @relation(fields: [nbfcCompanyId], references: [id])
  registrations             BusinessRegistration[]
  outgoingRelationships     BusinessRelationship[]     @relation("BusinessRelationshipFromProfile")
  incomingRelationships     BusinessRelationship[]     @relation("BusinessRelationshipToProfile")
  documentRequirements      DocumentRequirement[]
  informationRequests       InformationRequest[]
  notifications             Notification[]
  officialResponses         OfficialBusinessResponse[]
  claims                    ProfileClaim[]
  correctionRequests        ProfileCorrectionRequest[]
  regulatoryActions         RegulatoryAction[]
  verificationDecisions     VerificationDecision[]
  documents                 VerificationDocument[]
  verificationReviews       VerificationReview[]

  @@index([businessId])
  @@index([loanAppId])
  @@index([nbfcCompanyId])
  @@index([status])
  @@index([profileType])
}

model RegulatoryAction {
  id                    String                   @id @default(cuid())
  loanAppId             String?
  nbfcCompanyId         String?
  businessId            String?
  profileId             String?
  createdByUserId       String?
  verifiedByUserId      String?
  authorityName         String
  authorityJurisdiction String?                  @default("IN")
  actionType            RegulatoryActionType
  severity              RegulatoryActionSeverity @default(MEDIUM)
  status                RegulatoryActionStatus   @default(ACTIVE)
  title                 String
  summary               String?
  orderNumber           String?
  sourceUrl             String?
  sourceDocumentUrl     String?
  sourcePublishedAt     DateTime?
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  verifiedAt            DateTime?
  notes                 String?
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  business              BusinessAccount?         @relation(fields: [businessId], references: [id])
  createdBy             User?                    @relation("RegulatoryActionCreatedBy", fields: [createdByUserId], references: [id])
  loanApp               LoanApp?                 @relation(fields: [loanAppId], references: [id])
  nbfcCompany           NbfcCompany?             @relation(fields: [nbfcCompanyId], references: [id])
  profile               BusinessProfile?         @relation(fields: [profileId], references: [id])
  verifiedBy            User?                    @relation("RegulatoryActionVerifiedBy", fields: [verifiedByUserId], references: [id])

  @@index([loanAppId, status])
  @@index([nbfcCompanyId, status])
  @@index([businessId, status])
  @@index([profileId, status])
  @@index([actionType, status])
  @@index([severity, status])
  @@index([authorityName])
  @@index([sourcePublishedAt])
}

model BusinessMembership {
  id              String                   @id @default(cuid())
  businessId      String
  userId          String
  role            BusinessMembershipRole
  status          BusinessMembershipStatus @default(PENDING)
  version         Int                      @default(1)
  grantedByUserId String?
  invitedEmail    String?
  invitedAt       DateTime?
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  business        BusinessAccount          @relation(fields: [businessId], references: [id])
  grantedBy       User?                    @relation("BusinessMembershipGrantedBy", fields: [grantedByUserId], references: [id])
  user            User                     @relation("BusinessMembershipUser", fields: [userId], references: [id])

  @@unique([businessId, userId, role])
  @@index([businessId, status])
  @@index([userId, status])
  @@index([role])
}

model BusinessRegistration {
  id                 String                     @id @default(cuid())
  businessId         String
  profileId          String?
  submittedByUserId  String
  registrationType   BusinessRegistrationType
  registrationNumber String?
  issuingAuthority   String?
  countryCode        String                     @default("IN")
  status             BusinessRegistrationStatus @default(SUBMITTED)
  version            Int                        @default(1)
  submittedAt        DateTime                   @default(now())
  verifiedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  business           BusinessAccount            @relation(fields: [businessId], references: [id])
  profile            BusinessProfile?           @relation(fields: [profileId], references: [id])
  submittedBy        User                       @relation("BusinessRegistrationSubmittedBy", fields: [submittedByUserId], references: [id])
  documents          VerificationDocument[]

  @@index([businessId, status])
  @@index([profileId, status])
  @@index([submittedByUserId])
  @@index([registrationType, registrationNumber])
}

model ProfileClaim {
  id                  String                  @id @default(cuid())
  businessId          String
  profileId           String
  submittedByUserId   String
  status              ProfileClaimStatus      @default(SUBMITTED)
  version             Int                     @default(1)
  claimReason         String?
  requestedRole       BusinessMembershipRole?
  reviewedAt          DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  informationRequests InformationRequest[]
  business            BusinessAccount         @relation(fields: [businessId], references: [id])
  profile             BusinessProfile         @relation(fields: [profileId], references: [id])
  submittedBy         User                    @relation("ProfileClaimSubmittedBy", fields: [submittedByUserId], references: [id])
  documents           VerificationDocument[]
  reviews             VerificationReview[]

  @@index([businessId, status])
  @@index([profileId, status])
  @@index([submittedByUserId, status])
}

model VerificationDocument {
  id                   String                     @id @default(cuid())
  businessId           String
  profileId            String?
  submittedByUserId    String
  claimId              String?
  registrationId       String?
  requirementId        String?
  documentType         VerificationDocumentType
  status               VerificationDocumentStatus @default(UPLOADED)
  version              Int                        @default(1)
  storageKey           String
  maskedFileName       String
  originalFileNameHash String?
  mimeType             String
  fileSizeBytes        Int
  checksumSha256       String?
  sensitiveFlags       String[]
  reviewedAt           DateTime?
  expiresAt            DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  business             BusinessAccount            @relation(fields: [businessId], references: [id])
  claim                ProfileClaim?              @relation(fields: [claimId], references: [id])
  profile              BusinessProfile?           @relation(fields: [profileId], references: [id])
  registration         BusinessRegistration?      @relation(fields: [registrationId], references: [id])
  requirement          DocumentRequirement?       @relation(fields: [requirementId], references: [id])
  submittedBy          User                       @relation("VerificationDocumentSubmittedBy", fields: [submittedByUserId], references: [id])
  reviews              VerificationReview[]

  @@index([businessId, status])
  @@index([profileId, status])
  @@index([submittedByUserId])
  @@index([claimId])
  @@index([registrationId])
  @@index([requirementId])
}

model DocumentRequirement {
  id              String                    @id @default(cuid())
  businessId      String?
  profileId       String?
  requirementKey  String
  title           String
  description     String?
  documentType    VerificationDocumentType
  status          DocumentRequirementStatus @default(ACTIVE)
  version         Int                       @default(1)
  requiredForRole BusinessMembershipRole?
  dueAt           DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  business        BusinessAccount?          @relation(fields: [businessId], references: [id])
  profile         BusinessProfile?          @relation(fields: [profileId], references: [id])
  documents       VerificationDocument[]

  @@unique([businessId, profileId, requirementKey])
  @@index([businessId, status])
  @@index([profileId, status])
  @@index([documentType])
}

model EmailVerification {
  id         String                   @id @default(cuid())
  userId     String?
  businessId String?
  email      String
  tokenHash  String                   @unique
  status     EmailVerificationStatus  @default(PENDING)
  version    Int                      @default(1)
  purpose    EmailVerificationPurpose @default(USER_EMAIL)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  business   BusinessAccount?         @relation(fields: [businessId], references: [id])
  user       User?                    @relation("EmailVerificationUser", fields: [userId], references: [id])

  @@index([userId, status])
  @@index([businessId, status])
  @@index([email, status])
}

model DomainVerification {
  id                    String                   @id @default(cuid())
  businessId            String
  requestedByUserId     String
  domain                String
  verificationMethod    DomainVerificationMethod
  verificationValueHash String
  status                DomainVerificationStatus @default(PENDING)
  version               Int                      @default(1)
  attempts              Int                      @default(0)
  lastCheckedAt         DateTime?
  verifiedAt            DateTime?
  expiresAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  business              BusinessAccount          @relation(fields: [businessId], references: [id])
  requestedBy           User                     @relation("DomainVerificationRequestedBy", fields: [requestedByUserId], references: [id])

  @@unique([businessId, domain])
  @@index([businessId, status])
  @@index([requestedByUserId])
}

model BusinessRelationship {
  id               String                     @id @default(cuid())
  businessId       String
  fromProfileId    String?
  toProfileId      String?
  loanAppId        String?
  nbfcCompanyId    String?
  relationshipType BusinessRelationshipType
  status           BusinessRelationshipStatus @default(CLAIMED)
  version          Int                        @default(1)
  sourceUrl        String?
  confidence       VerificationConfidence     @default(LOW)
  verifiedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  business         BusinessAccount            @relation(fields: [businessId], references: [id])
  fromProfile      BusinessProfile?           @relation("BusinessRelationshipFromProfile", fields: [fromProfileId], references: [id])
  loanApp          LoanApp?                   @relation(fields: [loanAppId], references: [id])
  nbfcCompany      NbfcCompany?               @relation(fields: [nbfcCompanyId], references: [id])
  toProfile        BusinessProfile?           @relation("BusinessRelationshipToProfile", fields: [toProfileId], references: [id])
  reviews          VerificationReview[]

  @@index([businessId, status])
  @@index([fromProfileId])
  @@index([toProfileId])
  @@index([loanAppId])
  @@index([nbfcCompanyId])
  @@index([relationshipType, status])
}

model VerificationReview {
  id                  String                     @id @default(cuid())
  businessId          String
  profileId           String?
  claimId             String?
  documentId          String?
  relationshipId      String?
  assignedToUserId    String?
  status              VerificationReviewStatus   @default(QUEUED)
  version             Int                        @default(1)
  priority            VerificationReviewPriority @default(NORMAL)
  reviewNotes         String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  informationRequests InformationRequest[]
  decisions           VerificationDecision[]
  assignedTo          User?                      @relation("VerificationReviewAssignedTo", fields: [assignedToUserId], references: [id])
  business            BusinessAccount            @relation(fields: [businessId], references: [id])
  claim               ProfileClaim?              @relation(fields: [claimId], references: [id])
  document            VerificationDocument?      @relation(fields: [documentId], references: [id])
  profile             BusinessProfile?           @relation(fields: [profileId], references: [id])
  relationship        BusinessRelationship?      @relation(fields: [relationshipId], references: [id])

  @@index([businessId, status])
  @@index([profileId, status])
  @@index([claimId])
  @@index([documentId])
  @@index([relationshipId])
  @@index([assignedToUserId, status])
}

model VerificationDecision {
  id             String                      @id @default(cuid())
  reviewId       String
  businessId     String
  profileId      String?
  reviewerUserId String
  outcome        VerificationDecisionOutcome
  status         VerificationDecisionStatus  @default(FINAL)
  version        Int                         @default(1)
  reason         String
  internalNotes  String?
  effectiveAt    DateTime                    @default(now())
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  business       BusinessAccount             @relation(fields: [businessId], references: [id])
  profile        BusinessProfile?            @relation(fields: [profileId], references: [id])
  review         VerificationReview          @relation(fields: [reviewId], references: [id])
  reviewer       User                        @relation("VerificationDecisionReviewer", fields: [reviewerUserId], references: [id])

  @@index([reviewId])
  @@index([businessId, outcome])
  @@index([profileId, outcome])
  @@index([reviewerUserId])
}

model InformationRequest {
  id                String                   @id @default(cuid())
  businessId        String
  profileId         String?
  claimId           String?
  reviewId          String?
  requestedByUserId String
  respondedByUserId String?
  status            InformationRequestStatus @default(OPEN)
  version           Int                      @default(1)
  subject           String
  message           String
  responseText      String?
  dueAt             DateTime?
  respondedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  business          BusinessAccount          @relation(fields: [businessId], references: [id])
  claim             ProfileClaim?            @relation(fields: [claimId], references: [id])
  profile           BusinessProfile?         @relation(fields: [profileId], references: [id])
  requestedBy       User                     @relation("InformationRequestRequestedBy", fields: [requestedByUserId], references: [id])
  respondedBy       User?                    @relation("InformationRequestRespondedBy", fields: [respondedByUserId], references: [id])
  review            VerificationReview?      @relation(fields: [reviewId], references: [id])

  @@index([businessId, status])
  @@index([profileId, status])
  @@index([claimId])
  @@index([reviewId])
  @@index([requestedByUserId])
  @@index([respondedByUserId])
}

model OfficialBusinessResponse {
  id                String                         @id @default(cuid())
  businessId        String
  profileId         String?
  submittedByUserId String
  publicItemType    String
  publicItemId      String
  responseBody      String
  status            OfficialBusinessResponseStatus @default(SUBMITTED)
  version           Int                            @default(1)
  publishedAt       DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  business          BusinessAccount                @relation(fields: [businessId], references: [id])
  profile           BusinessProfile?               @relation(fields: [profileId], references: [id])
  submittedBy       User                           @relation("OfficialBusinessResponseSubmittedBy", fields: [submittedByUserId], references: [id])

  @@index([businessId, status])
  @@index([profileId, status])
  @@index([submittedByUserId])
  @@index([publicItemType, publicItemId])
}

model ProfileCorrectionRequest {
  id                String                         @id @default(cuid())
  businessId        String
  profileId         String
  submittedByUserId String
  fieldKey          String
  currentValue      String?
  proposedValue     String?
  explanation       String
  sourceUrl         String?
  status            ProfileCorrectionRequestStatus @default(SUBMITTED)
  version           Int                            @default(1)
  reviewedAt        DateTime?
  appliedAt         DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  business          BusinessAccount                @relation(fields: [businessId], references: [id])
  profile           BusinessProfile                @relation(fields: [profileId], references: [id])
  submittedBy       User                           @relation("ProfileCorrectionSubmittedBy", fields: [submittedByUserId], references: [id])

  @@index([businessId, status])
  @@index([profileId, status])
  @@index([submittedByUserId, status])
  @@index([fieldKey])
}

model HarassmentCase {
  id                      String               @id @default(cuid())
  userId                  String
  loanAppId               String?
  title                   String
  caseType                HarassmentCaseType
  status                  HarassmentCaseStatus @default(OPEN)
  priority                CasePriority         @default(NORMAL)
  summary                 String?
  incidentDate            DateTime?
  loanReferenceId         String?
  loanAmountRange         String?
  decisionTreeSessionId   String?
  linkedReviewId          String?
  linkedEvidenceFileIds   String[]
  linkedComplaintDraftIds String[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  checklistItems          CaseChecklistItem[]
  timelineItems           CaseTimelineItem[]
  externalComplaints      ExternalComplaint[]
  loanApp                 LoanApp?             @relation(fields: [loanAppId], references: [id])
  user                    User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loanAppId])
  @@index([status])
}

model CaseTimelineItem {
  id              String           @id @default(cuid())
  caseId          String
  type            CaseTimelineType
  title           String
  description     String?
  happenedAt      DateTime?
  evidenceFileIds String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  case            HarassmentCase   @relation(fields: [caseId], references: [id])

  @@index([caseId])
}

model CaseChecklistItem {
  id          String         @id @default(cuid())
  caseId      String
  label       String
  description String?
  completed   Boolean        @default(false)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  case        HarassmentCase @relation(fields: [caseId], references: [id])

  @@index([caseId])
}

model ExternalComplaint {
  id              String                   @id @default(cuid())
  caseId          String
  channel         ExternalComplaintChannel
  complaintNumber String?
  submittedAt     DateTime?
  status          ExternalComplaintStatus  @default(NOT_STARTED)
  notes           String?
  documentUrl     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  case            HarassmentCase           @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([channel])
}

model ComplaintTemplate {
  id          String                    @id @default(cuid())
  key         String                    @unique
  title       String
  category    ComplaintTemplateCategory
  description String
  outputTypes String[]
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  drafts      ComplaintDraft[]
}

model ComplaintDraft {
  id               String               @id @default(cuid())
  userId           String
  templateId       String?
  loanAppId        String?
  title            String
  templateKey      String
  outputType       ComplaintOutputType
  status           ComplaintDraftStatus @default(DRAFT)
  formData         Json
  generatedSubject String?
  generatedBody    String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  loanApp          LoanApp?             @relation(fields: [loanAppId], references: [id])
  template         ComplaintTemplate?   @relation(fields: [templateId], references: [id])
  user             User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([templateId])
  @@index([loanAppId])
  @@index([status])
}

model Review {
  id                String            @id @default(cuid())
  loanAppId         String
  userId            String?
  title             String
  body              String
  publicBody        String?
  rating            Int
  reviewType        ReviewType
  status            ReviewStatus      @default(SUBMITTED)
  displayMode       DisplayMode       @default(ANONYMOUS)
  incidentDate      DateTime?
  loanAmountRange   String?
  tags              String[]
  evidenceSubmitted Boolean           @default(false)
  redactionsApplied Boolean           @default(false)
  helpfulCount      Int               @default(0)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  companyResponses  CompanyResponse[]
  evidenceFiles     EvidenceFile[]
  loanApp           LoanApp           @relation(fields: [loanAppId], references: [id])
  user              User?             @relation(fields: [userId], references: [id])
  reports           ReviewReport[]

  @@index([loanAppId])
  @@index([userId])
  @@index([status])
}

model ReviewReport {
  id             String             @id @default(cuid())
  reviewId       String
  reporterUserId String?
  reason         String
  note           String?
  status         ReviewReportStatus @default(PENDING_REVIEW)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  reporter       User?              @relation(fields: [reporterUserId], references: [id])
  review         Review             @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
  @@index([reporterUserId])
  @@index([status])
}

model EvidenceFile {
  id                   String          @id @default(cuid())
  userId               String?
  loanAppId            String?
  reviewId             String?
  storageKey           String
  maskedFileName       String
  originalFileNameHash String?
  mimeType             String
  fileSizeBytes        Int
  status               EvidenceStatus  @default(UPLOADED)
  privateByDefault     Boolean         @default(true)
  sensitiveFlags       String[]
  redactionStatus      RedactionStatus @default(NOT_STARTED)
  uploadedAt           DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  loanApp              LoanApp?        @relation(fields: [loanAppId], references: [id])
  review               Review?         @relation(fields: [reviewId], references: [id])
  user                 User?           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loanAppId])
  @@index([reviewId])
  @@index([status])
}

model CompanyResponse {
  id              String                  @id @default(cuid())
  reviewId        String
  responderUserId String?
  companyName     String
  body            String
  category        CompanyResponseCategory
  status          ModerationStatus        @default(PENDING)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  review          Review                  @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
  @@index([status])
}

model ComplaintSummary {
  id               String   @id @default(cuid())
  loanAppId        String
  tag              String
  count            Int      @default(0)
  percentage       Float    @default(0)
  lastCalculatedAt DateTime @default(now())
  loanApp          LoanApp  @relation(fields: [loanAppId], references: [id])

  @@unique([loanAppId, tag])
  @@index([tag])
}

model CorrectionRequest {
  id             String           @id @default(cuid())
  requesterId    String?
  requestType    String
  status         CorrectionStatus @default(SUBMITTED)
  publicItemType String?
  publicItemId   String?
  explanation    String
  currentValue   String?
  proposedValue  String?
  sourceUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  requester      User?            @relation(fields: [requesterId], references: [id])

  @@index([requesterId])
  @@index([status])
  @@index([publicItemType, publicItemId])
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  priority   NotificationPriority @default(NORMAL)
  read       Boolean              @default(false)
  relatedUrl String?
  createdAt  DateTime             @default(now())
  businessId String?
  profileId  String?
  version    Int                  @default(1)
  updatedAt  DateTime             @default(now()) @updatedAt
  business   BusinessAccount?     @relation(fields: [businessId], references: [id])
  profile    BusinessProfile?     @relation(fields: [profileId], references: [id])
  user       User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([businessId])
  @@index([profileId])
  @@index([read])
  @@index([priority])
}

model NotificationSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailEnabled          Boolean  @default(true)
  inAppEnabled          Boolean  @default(true)
  reviewStatusUpdates   Boolean  @default(true)
  companyResponseAlerts Boolean  @default(true)
  correctionUpdates     Boolean  @default(true)
  evidenceUpdates       Boolean  @default(true)
  adminAlerts           Boolean  @default(false)
  savedAppAlerts        Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String           @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  beforeJson Json?
  afterJson  Json?
  reason     String?
  createdAt  DateTime         @default(now())
  businessId String?
  profileId  String?
  version    Int              @default(1)
  actor      User?            @relation("AuditLogActor", fields: [actorId], references: [id])
  business   BusinessAccount? @relation(fields: [businessId], references: [id])
  profile    BusinessProfile? @relation(fields: [profileId], references: [id])

  @@index([actorId])
  @@index([businessId])
  @@index([profileId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ScoringConfig {
  id                             String   @id @default(cuid())
  name                           String   @unique
  active                         Boolean  @default(false)
  averageRatingWeight            Float    @default(20)
  reviewVolumeWeight             Float    @default(10)
  recentComplaintTrendWeight     Float    @default(15)
  complaintSeverityWeight        Float    @default(20)
  verifiedBorrowerWeight         Float    @default(5)
  companyResponseWeight          Float    @default(10)
  grievanceAvailabilityWeight    Float    @default(10)
  publicDetailVerificationWeight Float    @default(5)
  reviewIntegrityWeight          Float    @default(5)
  severeComplaintPenalty         Float    @default(25)
  privacyComplaintPenalty        Float    @default(15)
  hiddenChargeComplaintPenalty   Float    @default(10)
  staleVerificationPenalty       Float    @default(8)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

