# Copy this file to .env or .env.local locally.
# Never commit real secrets.

# Database connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="borrowscope:dev"
TURNSTILE_SECRET_KEY="replace-with-cloudflare-turnstile-secret"

# Authentication / session signing
AUTH_SECRET="replace-with-at-least-32-random-characters"
JWT_SECRET="replace-with-at-least-32-random-characters-if-used"
SESSION_SIGNING_KEY="replace-with-at-least-32-random-characters-if-used"

# Email provider
EMAIL_API_KEY="replace-with-secret-manager-value"
EMAIL_DELIVERY_WEBHOOK_URL="https://your-email-service.example/auth-email"
PUBLIC_APP_ORIGIN="http://localhost:3000"

# AI provider
AI_API_KEY="replace-with-secret-manager-value"
OPENAI_API_KEY="replace-with-secret-manager-value-if-used"

# Encryption / cloud credentials
ENCRYPTION_KEY="replace-with-secret-manager-value"
CLOUD_ACCESS_KEY_ID="replace-with-secret-manager-value"
CLOUD_SECRET_ACCESS_KEY="replace-with-secret-manager-value"

# Public frontend configuration, safe only if values are intentionally public
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-cloudflare-turnstile-site-key"

# CSP starts in report-only mode. Review CSP_VIOLATION logs before enforcing.
CSP_ENFORCE="false"
# Optional comma/space-separated HTTPS origins required by browser fetches.
CSP_CONNECT_SRC=""

# Protected external SIEM/log-drain endpoint. Required for durable security
# alert retention outside the primary application database in production.
SECURITY_EVENT_SINK_URL="https://security-events.example/v1/events"
SECURITY_EVENT_SINK_TOKEN="replace-with-secret-manager-value"

# Backend local settings
PORT="4000"
CORS_ORIGIN="http://localhost:3000"
TRUST_PROXY="false"
